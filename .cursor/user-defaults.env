# 用户固定默认值 — 创建新项目时直接使用，勿重复询问

GITHUB_OWNER=follower-ding
GITHUB_REPO_VISIBILITY=public
GITHUB_CREATE_REMOTE=yes
DEPLOY_HOST=49.235.172.214
DEPLOY_SSH_USER=iume
DEPLOY_PATH_TEMPLATE=/opt/<项目名>/deploy

# 页面设计
DESIGN_SKILL=ui-ux-pro-max
DESIGN_STYLE=elegant minimal
UI_LAYOUT=AppShell+Sidebar
UI_STACK_DEFAULT=react

# 技能自动启用（创建项目时按类型/规模挂载，勿重复询问）
SKILL_API_CONTRACT_SYNC=always
SKILL_SECRETS_GUARD=always
SKILL_RELEASE_NOTES=always
SKILL_SEO_BLOG=blog,writing,content
SKILL_E2E_PLAYWRIGHT=medium,large
